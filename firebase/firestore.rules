rules_version = '2';

// Arion — biblioteca compartilhada por grupo (banda, coral, ministério...).
//
// acervo/{id}                      acervo geral: quem está liberado vê; dono + editores mudam
// acervo/{id}/versoes/{n}          histórico de cada música do acervo (imutável)
// acervoSugestoes/{id}             sugestão p/ música do acervo
// confianca/{dono}                 quem mexe em TODO o acervo de {dono}
// pessoas/{email}                  nome de cada usuário
// sessoes/{codigo}                 sessão ao vivo: IPs de quem criou (abre por código)
// liberados/{email}                quem pode usar a nuvem (login Google é aberto, mas
//                                  só lê/grava quem foi liberado; convidar p/ um grupo libera)
// grupos/{g}                       nome, dono (e-mail), membros [e-mails]
// grupos/{g}/pessoas/{email}       nome de quem é do grupo
// grupos/{g}/confianca/{dono}      editores [e-mails] que mexem em TODAS as músicas/repertórios de {dono}
// grupos/{g}/musicas/{id}          música + dono, editores, versao, atualizadoPor, apagada
// grupos/{g}/musicas/{id}/versoes/{n}   retrato completo de cada gravação (imutável)
// grupos/{g}/repertorios/{id}      repertório + dono, editores, apagada
// grupos/{g}/sugestoes/{id}        mudança proposta por quem não pode editar
//
// E-mails sempre em minúsculas.
service cloud.firestore {
  match /databases/{database}/documents {

    function eu() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower() : '';
    }

    // quem começa liberado sem precisar de ninguém (o dono do app)
    function admin() {
      return eu() in ['mviniciusdospassos@gmail.com'];
    }

    // login Google é aberto a qualquer conta: sem isso qualquer um gastaria a
    // cota do projeto. Só usa a nuvem quem um liberado liberou (ao convidar).
    function liberado() {
      return eu() != '' && (admin()
        || exists(/databases/$(database)/documents/liberados/$(eu())));
    }

    function grupo(g) {
      return get(/databases/$(database)/documents/grupos/$(g)).data;
    }

    function membro(g) {
      let gr = grupo(g);
      return eu() != '' && (eu() == gr.dono || eu() in gr.membros);
    }

    function confia(g, dono) {
      let p = /databases/$(database)/documents/grupos/$(g)/confianca/$(dono);
      return exists(p) && eu() in get(p).data.editores;
    }

    // dono, editor da própria música/repertório, ou alguém em quem o dono confia
    function podeEditar(g, d) {
      return eu() == d.dono || eu() in d.get('editores', []) || confia(g, d.dono);
    }

    // ---- acervo geral ----
    function confiaAcervo(dono) {
      let p = /databases/$(database)/documents/confianca/$(dono);
      return exists(p) && eu() in get(p).data.editores;
    }

    function podeEditarAcervo(d) {
      return eu() == d.dono || eu() in d.get('editores', []) || confiaAcervo(d.dono);
    }

    function soMudou(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // cada um confere se está liberado; quem é liberado libera outros (só
    // registra quem liberou). Tirar a liberação: só o dono do app.
    match /liberados/{email} {
      allow get: if eu() == email || liberado();
      allow list: if admin();
      allow create, update: if liberado() && email == email.lower()
        && request.resource.data.keys().hasOnly(['por', 'em'])
        && request.resource.data.por == eu();
      allow delete: if admin();
    }

    // pedido de exclusão da conta (LGPD art. 18). Qualquer conta logada pede a
    // própria; o dono do app roda firebase/excluir-contas.mjs, que apaga tudo.
    match /exclusoes/{email} {
      allow get: if eu() == email || admin();
      allow list, delete: if admin();
      allow create, update: if eu() != '' && eu() == email
        && request.resource.data.keys().hasOnly(['em', 'nome'])
        && request.resource.data.em == request.time;
    }

    match /pessoas/{email} {
      allow read: if liberado();
      allow write: if liberado() && eu() == email;
    }

    match /confianca/{dono} {
      allow read: if liberado();
      allow write: if liberado() && eu() == dono;
    }

    match /acervo/{id} {
      allow read: if liberado();
      allow create: if liberado() && request.resource.data.dono == eu()
        && request.resource.data.get('editores', []) is list;
      allow update: if podeEditarAcervo(resource.data)
        && request.resource.data.dono == resource.data.dono
        && (eu() == resource.data.dono
            || (request.resource.data.get('editores', []) == resource.data.get('editores', [])
                && request.resource.data.get('apagada', false) == resource.data.get('apagada', false)));
      allow delete: if false;

      match /versoes/{n} {
        allow read: if liberado();
        allow create: if liberado() && request.resource.data.por == eu()
          && podeEditarAcervo(getAfter(/databases/$(database)/documents/acervo/$(id)).data);
        allow update, delete: if false;
      }
    }

    match /acervoSugestoes/{id} {
      allow read: if liberado();
      allow create: if liberado() && request.resource.data.por == eu()
        && request.resource.data.status == 'pendente';
      allow update: if liberado() && resource.data.status == 'pendente' && (
        (request.resource.data.status in ['aceita', 'recusada']
          && request.resource.data.decididoPor == eu()
          && podeEditarAcervo(get(/databases/$(database)/documents/acervo/$(resource.data.songId)).data)
          && soMudou(['status', 'decididoPor', 'decididoPorNome', 'decididoEm', 'motivo']))
        || (request.resource.data.status == 'cancelada' && resource.data.por == eu()
          && soMudou(['status', 'decididoEm'])));
      allow delete: if false;
    }

    // ---- sessão ao vivo: código de 4 dígitos -> IPs do aparelho que criou ----
    // Só abre por código (sem listar). Código abandonado (>10 min sem sinal)
    // pode ser reaproveitado por outra pessoa.
    match /sessoes/{codigo} {
      allow get: if liberado();
      allow list: if false;
      allow create: if liberado() && codigo.matches('[0-9]{4}')
        && request.resource.data.dono == eu();
      allow update: if liberado() && request.resource.data.dono == eu()
        && (resource.data.dono == eu()
            || resource.data.vivoEm < request.time - duration.value(10, 'm'));
      allow delete: if eu() == resource.data.dono;
    }

    match /grupos/{g} {
      allow read: if eu() != '' && (eu() == resource.data.dono || eu() in resource.data.membros);
      allow create: if liberado() && request.resource.data.dono == eu()
        && request.resource.data.membros is list;
      // só o dono do grupo convida/remove gente; dono do grupo não muda
      allow update: if eu() == resource.data.dono && request.resource.data.dono == resource.data.dono;
      allow delete: if false;

      // nome de cada membro p/ mostrar nas telas; cada um grava o seu
      match /pessoas/{email} {
        allow read: if membro(g);
        allow write: if membro(g) && eu() == email;
      }

      match /confianca/{dono} {
        allow read: if membro(g);
        allow write: if membro(g) && eu() == dono;
      }

      match /musicas/{id} {
        allow read: if membro(g);
        // quem cria é o dono
        allow create: if membro(g) && request.resource.data.dono == eu()
          && request.resource.data.get('editores', []) is list;
        allow update: if membro(g) && podeEditar(g, resource.data)
          // ninguém troca o dono
          && request.resource.data.dono == resource.data.dono
          // só o dono mexe em quem pode editar e apaga/restaura a música
          && (eu() == resource.data.dono
              || (request.resource.data.get('editores', []) == resource.data.get('editores', [])
                  && request.resource.data.get('apagada', false) == resource.data.get('apagada', false)));
        allow delete: if false; // apagar = marcar apagada (vira lápide p/ quem está offline)

        match /versoes/{n} {
          allow read: if membro(g);
          // a versão vai no mesmo lote da gravação da música: confere a música JÁ gravada
          allow create: if membro(g) && request.resource.data.por == eu()
            && podeEditar(g, getAfter(/databases/$(database)/documents/grupos/$(g)/musicas/$(id)).data);
          allow update, delete: if false;
        }
      }

      match /repertorios/{id} {
        allow read: if membro(g);
        allow create: if membro(g) && request.resource.data.dono == eu();
        allow update: if membro(g) && podeEditar(g, resource.data)
          && request.resource.data.dono == resource.data.dono
          && (eu() == resource.data.dono
              || (request.resource.data.get('editores', []) == resource.data.get('editores', [])
                  && request.resource.data.get('apagada', false) == resource.data.get('apagada', false)));
        allow delete: if false;
      }

      match /sugestoes/{id} {
        allow read: if membro(g);
        allow create: if membro(g) && request.resource.data.por == eu()
          && request.resource.data.status == 'pendente';
        allow update: if membro(g) && resource.data.status == 'pendente' && (
          // quem pode editar a música decide
          (request.resource.data.status in ['aceita', 'recusada']
            && request.resource.data.decididoPor == eu()
            && podeEditar(g, get(/databases/$(database)/documents/grupos/$(g)/musicas/$(resource.data.songId)).data)
            && soMudou(['status', 'decididoPor', 'decididoPorNome', 'decididoEm', 'motivo']))
          // quem sugeriu pode desistir
          || (request.resource.data.status == 'cancelada' && resource.data.por == eu()
            && soMudou(['status', 'decididoEm'])));
        allow delete: if false;
      }
    }
  }
}
